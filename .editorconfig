root = true

[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
charset = utf-8-bom
indent_size = 4

[*.xml]
indent_size = 2

[*.{props,targets,config}]
indent_size = 2

[*.json]
indent_size = 2

[*.axaml]
indent_size = 4

# Verify settings
[*.{received,verified}.{cs,txt}]
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false
