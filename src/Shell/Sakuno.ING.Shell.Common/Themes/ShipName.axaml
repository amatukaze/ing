<ResourceDictionary xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:controls="using:Sakuno.ING.Shell.Controls">
    <ControlTheme x:Key="{x:Type controls:ShipName}" TargetType="controls:ShipName">
        <Setter Property="Template">
            <ControlTemplate>
                <TextBlock Name="PART_TextBlock" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
