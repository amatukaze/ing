<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="clr-namespace:Sakuno.ING.ViewModels.Homeport;assembly=Sakuno.ING.ViewModels"
                          xmlns:controls="clr-namespace:Sakuno.ING.Shell.Controls;assembly=Sakuno.ING.Shell.Common"
                          mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                          x:Class="Sakuno.ING.Shell.Views.Overall.FleetExpedition"
                          x:TypeArguments="vm:FleetViewModel"
                          x:DataType="vm:FleetViewModel">
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Id}" />
        <controls:ExpeditionName Expedition="{Binding ExpeditionId^}" />
    </StackPanel>
</rxui:ReactiveUserControl>
