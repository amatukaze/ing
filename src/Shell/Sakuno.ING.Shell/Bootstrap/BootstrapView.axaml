<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="clr-namespace:Sakuno.ING.ViewModels.Bootstrap;assembly=Sakuno.ING.ViewModels"
                          mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="220"
                          x:Class="Sakuno.ING.Shell.Bootstrap.BootstrapView"
                          x:TypeArguments="vm:BootstrapViewModel"
                          x:DataType="vm:BootstrapViewModel">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto" MinWidth="360">
    <TextBlock Grid.Row="0"
               Text="正在启动 ING"
               FontSize="16" FontWeight="SemiBold"
               Margin="0,0,0,12" />
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:BootstrapStepViewModel">
          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusGlyph}"
                       MinWidth="16" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Message}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasError}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                  IsVisible="{Binding HasError}">
        <Button Content="重试" Command="{Binding RetryCommand}" />
        <Button Content="跳过"
                Command="{Binding SkipCommand}"
                IsVisible="{Binding FailedStep.CanSkip}" />
        <Button Content="退出" Command="{Binding ExitCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</rxui:ReactiveUserControl>
