<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="clr-namespace:Sakuno.ING.ViewModels;assembly=Sakuno.ING.ViewModels"
                          xmlns:overall="clr-namespace:Sakuno.ING.Shell.Views.Overall;assembly=Sakuno.ING.Shell.Views.Overall"
                          mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                          x:Class="Sakuno.ING.Shell.MainView"
                          x:TypeArguments="vm:MainWindowViewModel"
                          x:DataType="vm:MainWindowViewModel">
    <StackPanel>
        <overall:OverallView />
    </StackPanel>
</rxui:ReactiveUserControl>
