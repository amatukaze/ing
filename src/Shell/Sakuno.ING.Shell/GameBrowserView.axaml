<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:rxui="http://reactiveui.net"
                            xmlns:vm="clr-namespace:Sakuno.ING.ViewModels;assembly=Sakuno.ING.ViewModels"
                            mc:Ignorable="d"
                            x:Class="Sakuno.ING.Shell.GameBrowserView"
                            x:TypeArguments="vm:BrowserViewModel"
                            x:DataType="vm:BrowserViewModel">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <Button Grid.Row="0" Grid.Column="0" Command="{Binding GoBack}" Content="←" />
        <Button Grid.Row="0" Grid.Column="1" Command="{Binding GoForward}" Content="→" />
        <Button Grid.Row="0" Grid.Column="2" Command="{Binding Refresh}" Content="⟳" />
        <Button Grid.Row="0" Grid.Column="3" Command="{Binding Stop}" Content="■" />
        <Button Grid.Row="0" Grid.Column="4" Command="{Binding GoHome}" Content="⌂" />
        <TextBox Grid.Row="0" Grid.Column="5"
                 x:Name="AddressBar"
                 Text="{Binding Address, Mode=TwoWay}"
                 Watermark="URL"
                 KeyDown="OnAddressBarKeyDown" />
        <NativeWebView x:Name="GameWebView" Grid.Row="1" Grid.ColumnSpan="6"
                       Source="{Binding Source, Mode=TwoWay}" />
    </Grid>
</rxui:ReactiveUserControl>
