<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InjectioName>GameProvider</InjectioName>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="InjectioName" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Injectio" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(BasePath)src\Infrastructure\Sakuno.ING.Standard\Sakuno.ING.Standard.csproj" />
        <ProjectReference Include="$(BasePath)src\Game\Sakuno.ING.Game.Core\Sakuno.ING.Game.Core.csproj" />
        <ProjectReference Include="$(BasePath)src\Game\Sakuno.ING.Game.Provider.Json\Sakuno.ING.Game.Provider.Json.csproj" />
        <ProjectReference Include="$(BasePath)src\Game\Sakuno.ING.Game.Provider.SourceGenerators\Sakuno.ING.Game.Provider.SourceGenerators.csproj">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
    </ItemGroup>

</Project>
