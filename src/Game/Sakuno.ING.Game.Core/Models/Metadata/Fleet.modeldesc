@using Sakuno.ING.Game.Events
@using Sakuno.ING.Game.Models.MasterData
@id FleetId
@raw IFleetUpdated

string Name
IReadOnlyList<ShipId> Ships

FleetExpeditionState ExpeditionState
ExpeditionId ExpeditionId
DateTimeOffset ExpeditionCompletionTime

@patchbase IFleetPatched
@patch FleetShipsPatch Ships
@patch FleetExpeditionPatch ExpeditionId ExpeditionState ExpeditionCompletionTime
